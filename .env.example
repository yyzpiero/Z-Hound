# Copy to .env locally. Never commit real credentials.
# HTTPS origin only. Leave default for official FOFA, or set your trusted compatible service.
FOFA_BASE_URL=https://fofa.info
# Optional legacy account email; current official API supports key-only access.
FOFA_EMAIL=
FOFA_API_KEY=
DEEPSEEK_API_KEY=
# Change to a model available to your DeepSeek account.
DEEPSEEK_MODEL=deepseek-flash
